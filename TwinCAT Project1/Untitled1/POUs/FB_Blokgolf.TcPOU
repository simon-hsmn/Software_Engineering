<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_Blokgolf" Id="{d0b27e9a-7cde-4b2e-a891-902789c8648a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Blokgolf
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	_timer1 : TP;
	_timer2 : TP;
	bEnabled: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_timer1.IN := bEnabled AND NOT _timer2.Q;
_timer1();

_timer2.IN := bEnabled AND NOT _timer1.Q;
_timer2();]]></ST>
    </Implementation>
