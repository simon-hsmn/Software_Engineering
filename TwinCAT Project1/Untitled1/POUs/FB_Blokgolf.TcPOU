    <Method Name="M_Start" Id="{d7473e49-bd23-4ff1-8062-541eb712e25e}">
      <Declaration><![CDATA[METHOD PUBLIC M_Start
VAR_INPUT
	onTime : TIME;
	offTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bEnabled := TRUE;
_timer1.PT := onTime;
_timer2.PT := offTime;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Stop" Id="{189d4a1f-c273-4665-af82-f2d525d6f123}">
      <Declaration><![CDATA[METHOD PUBLIC M_Stop
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bEnabled := false;]]></ST>
      </Implementation>
    </Method>
