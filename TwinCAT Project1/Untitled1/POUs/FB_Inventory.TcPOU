    <Method Name="M_Remove" Id="{d8764512-37aa-4b16-b675-337ad4ad0d0e}">
      <Declaration><![CDATA[METHOD PUBLIC M_Remove
VAR_INPUT
	nIndex : INT;
END_VAR
VAR
	stNullProduct : ST_ProductInfo := (eproductType := E_ProductType.cube, fDimension1 := 0, fDimension2 := 0, fDimension3 := 0, fSpecificWeight := 0);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stInventory[nIndex] := _stInventory[_nNumberProducts - 1];
_stInventory[_nNumberProducts - 1] := stNullProduct;
_nNumberProducts := _nNumberProducts - 1;]]></ST>
      </Implementation>
    </Method>
