	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	product1 : ST_ProductInfo;
	product2 : ST_ProductInfo;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Add(product1);
M_Add(product2);]]></ST>
      </Implementation>
    </Method>
