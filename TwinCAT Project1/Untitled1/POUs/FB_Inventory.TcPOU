    <Method Name="M_Add" Id="{60b6ffc1-062c-4858-a5b9-496d0cf9a5e1}">
      <Declaration><![CDATA[METHOD PUBLIC M_Add
VAR_INPUT
	stProductInfo : ST_ProductInfo;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stInventory[_nNumberProducts] := stProductInfo;
_nNumberProducts := _nNumberProducts + 1;]]></ST>
      </Implementation>
    </Method>
